local IntegrityMesh = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

local function verifyEnvironment()
    if getgenv then
        local success = pcall(function()
            local env = getgenv()
            if type(env) == "table" and next(env) ~= nil then
                return false
            end
        end)
        if not success then
            return false
        end
    end

    local criticalGlobals = {print, error, typeof, rawequal, tick, os}
    for _, fn in ipairs(criticalGlobals) do
        local info = debug.getinfo(fn)
        if not info or type(info) ~= "table" then
            return false
        end
    end

    local mt = getmetatable(game)
    if mt then
        local success = pcall(function()
            local _ = mt.__namecall
        end)
        if success then
            return false
        end
    end

    return true
end

local function initWatchdog()
    local lastTick = tick()
    
    RunService.Heartbeat:Connect(function()
        lastTick = tick()
    end)

    task.spawn(function()
        while true do
            task.wait(5)
            if (tick() - lastTick) > 2.5 then
                localPlayer:Kick("Integrity violation: Execution thread anomaly detected.")
                break
            end
        end
    end)
end

function IntegrityMesh.watchInstance(targetInstance, callback)
    if not targetInstance then return end
    
    targetInstance.AncestryChanged:Connect(function(_, parent)
        if not parent then
            callback()
        end
    end)
    
    if targetInstance:IsA("LocalScript") or targetInstance:IsA("ModuleScript") then
        targetInstance.Changed:Connect(function(property)
            if property == "Disabled" and targetInstance.Disabled == false then
            end
        end)
    end
end

function IntegrityMesh.initServerSync(remoteEvent)
    if not remoteEvent then return end

    remoteEvent.OnClientEvent:Connect(function(challengeToken)
        local responseToken = bit32.bxor(challengeToken, 0x5A5A5A5A) * 2
        remoteEvent:FireServer(responseToken)
    end)
end

function IntegrityMesh.init(syncRemote)
    if not verifyEnvironment() then
        localPlayer:Kick("Security consistency check failed at startup.")
        return
    end

    initWatchdog()
    
    if syncRemote then
        IntegrityMesh.initServerSync(syncRemote)
    end

    task.spawn(function()
        while true do
            task.wait(10)
            if not verifyEnvironment() then
                localPlayer:Kick("Security consistency check failed during runtime.")
                break
            end
        end
    end)
end

return IntegrityMesh
